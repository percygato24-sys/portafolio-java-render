<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*,com.mongodb.client.gridfs.model.GridFSFile" %>
<%
String ctx=request.getContextPath();
int numero=(Integer)request.getAttribute("numeroSemana");
List<GridFSFile> trabajos=(List<GridFSFile>)request.getAttribute("trabajos");
boolean admin=Boolean.TRUE.equals(session.getAttribute("admin"));
String estado=request.getParameter("estado");
%>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Semana <%=numero%> | Mi Portafolio</title><link rel="stylesheet" href="<%=ctx%>/css/estilos.css"></head>
<body><div class="app-shell">
<aside class="sidebar"><a class="brand" href="<%=ctx%>/inicio"><span class="brand-mark">P</span><span>PORTAFOLIO<small>UNIVERSITARIO</small></span></a><div class="side-label">MENÚ PRINCIPAL</div><a class="nav-link" href="<%=ctx%>/inicio"><span>⌂</span> Inicio</a><div class="side-label">CONTENIDO ACADÉMICO</div><div class="week-nav"><%for(int i=1;i<=16;i++){%><a class="nav-link <%=i==numero?"active":""%>" href="<%=ctx%>/semana?n=<%=i%>"><span class="week-number"><%=String.format("%02d",i)%></span> Semana <%=i%></a><%}%></div><div class="sidebar-bottom"><%if(admin){%><a class="nav-link" href="<%=ctx%>/salir"><span>↪</span> Cerrar sesión</a><%}else{%><a class="nav-link" href="<%=ctx%>/login"><span>⚿</span> Administración</a><%}%><div class="profile-mini"><div class="avatar">PA</div><div><strong>Mi portafolio</strong><small>Ingeniería de Sistemas</small></div></div></div></aside>
<main class="main-content"><header class="topbar"><div><a class="back-link" href="<%=ctx%>/inicio">← Volver al inicio</a><h1>Semana <%=numero%></h1></div><%if(admin){%><a class="admin-button" href="<%=ctx%>/salir">Cerrar sesión</a><%}else{%><a class="admin-button" href="<%=ctx%>/login">⌘ Administración</a><%}%></header>
<section class="week-banner"><div><span class="pill"><i></i> CONTENIDO ACADÉMICO</span><h2>Semana <%=numero%><span>.</span></h2><p>Consulta los documentos y actividades correspondientes a esta semana.</p></div><div class="banner-number"><%=String.format("%02d",numero)%></div></section>
<%if("ok".equals(estado)){%><div class="notice success">✓ El trabajo se guardó correctamente.</div><%}else if("tipo".equals(estado)){%><div class="notice warning">El archivo no está permitido o supera los 20 MB. Usa PDF, Word, PowerPoint, Excel o imágenes JPG/PNG.</div><%}else if("datos".equals(estado)){%><div class="notice warning">Completa el título y selecciona un archivo.</div><%}else if("bd".equals(estado)){%><div class="notice warning">No se pudo guardar. Comprueba la conexión con MongoDB.</div><%}%>
<section class="section-block"><div class="section-heading"><div><span class="eyebrow">ARCHIVO DE LA SEMANA</span><h2>Mis trabajos</h2><p><%=trabajos.size()%> documento(s) registrado(s).</p></div></div>
<%if(trabajos.isEmpty()){%><div class="empty-state"><div class="empty-icon">▱</div><h3>Aún no hay trabajos</h3><p>Cuando subas una actividad, aparecerá aquí.</p></div><%}else{%><div class="document-list"><%for(GridFSFile f:trabajos){org.bson.Document md=f.getMetadata();String titulo=md==null?"":md.getString("titulo");String descripcion=md==null?"":md.getString("descripcion");%><article class="document-card"><div class="file-icon">▤</div><div class="file-info"><h3><%=com.portafolio.config.HtmlUtil.escape(titulo==null||titulo.isBlank()?f.getFilename():titulo)%></h3><p><%=com.portafolio.config.HtmlUtil.escape(descripcion==null?"":descripcion)%></p><small><%=com.portafolio.config.HtmlUtil.escape(f.getFilename())%> · <%=String.format("%.2f",f.getLength()/1024.0)%> KB</small></div><a class="download-button" href="<%=ctx%>/descargar?id=<%=f.getObjectId()%>">↓ Descargar</a><%if(admin){%><form method="post" action="<%=ctx%>/eliminar" onsubmit="return confirm('¿Eliminar este documento?');"><input type="hidden" name="id" value="<%=f.getObjectId()%>"><input type="hidden" name="semana" value="<%=numero%>"><button class="delete-button" type="submit" aria-label="Eliminar">×</button></form><%}%></article><%}%></div><%}%>
</section>
<%if(admin){%><section class="upload-panel"><div class="section-heading"><div><span class="eyebrow">ADMINISTRACIÓN</span><h2>Subir un trabajo</h2><p>Agrega un documento a la semana <%=numero%>.</p></div><span class="upload-symbol">＋</span></div>
<form class="upload-form" method="post" action="<%=ctx%>/subir" enctype="multipart/form-data"><input type="hidden" name="semana" value="<%=numero%>"><label>Título del trabajo<input type="text" name="titulo" maxlength="120" placeholder="Ej. Práctica de laboratorio" required></label><label>Descripción<textarea name="descripcion" rows="3" maxlength="500" placeholder="Escribe una breve descripción (opcional)"></textarea></label><label>Seleccionar archivo<input type="file" name="archivo" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.jpg,.jpeg,.png" required></label><p class="form-hint">Formatos: PDF, Word, PowerPoint, Excel, JPG y PNG. Máximo 20 MB por archivo.</p><button class="primary-button" type="submit">Guardar trabajo <span>↑</span></button></form></section><%}else{%><div class="admin-hint">¿Necesitas agregar o administrar trabajos? <a href="<%=ctx%>/login">Ingresa como administrador.</a></div><%}%>
<footer class="footer"><span>MI PORTAFOLIO UNIVERSITARIO</span><span>Semana <%=numero%> · 2026</span></footer></main></div></body></html>
