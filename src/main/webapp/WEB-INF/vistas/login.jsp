<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<% String ctx=request.getContextPath(); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Administración | Mi Portafolio</title><link rel="stylesheet" href="<%=ctx%>/css/estilos.css"></head>
<body class="login-body"><div class="login-card"><a class="brand login-brand" href="<%=ctx%>/inicio"><span class="brand-mark">P</span><span>PORTAFOLIO<small>UNIVERSITARIO</small></span></a><span class="eyebrow">ÁREA PRIVADA</span><h1>Bienvenido de nuevo</h1><p>Ingresa para administrar tus trabajos y documentos.</p><%if(request.getAttribute("error")!=null){%><div class="notice warning"><%=request.getAttribute("error")%></div><%}%><form class="upload-form" method="post" action="<%=ctx%>/login"><label>Usuario<input type="text" name="usuario" placeholder="Tu usuario" required autocomplete="username"></label><label>Contraseña<input type="password" name="clave" placeholder="Tu contraseña" required autocomplete="current-password"></label><button class="primary-button full-button" type="submit">Ingresar al panel <span>→</span></button></form><a class="back-link login-back" href="<%=ctx%>/inicio">← Volver al portafolio</a></div></body></html>
